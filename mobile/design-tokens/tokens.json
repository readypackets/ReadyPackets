{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "ReadyPackets Native Mobile Tokens",
  "version": "1.0.0",
  "color": {
    "brand": {
      "navy": { "$type": "color", "$value": "#0D1B2A" },
      "navyRaised": { "$type": "color", "$value": "#12263A" },
      "navyElevated": { "$type": "color", "$value": "#17304A" },
      "teal": { "$type": "color", "$value": "#20A090" },
      "tealDark": { "$type": "color", "$value": "#1A7A6E" },
      "tealLight": { "$type": "color", "$value": "#2EC4B6" },
      "gold": { "$type": "color", "$value": "#C9A84C" },
      "goldDark": { "$type": "color", "$value": "#A98C36" }
    },
    "semantic": {
      "background": { "$type": "color", "$value": "{color.brand.navy}" },
      "surface": { "$type": "color", "$value": "{color.brand.navyRaised}" },
      "surfaceElevated": { "$type": "color", "$value": "{color.brand.navyElevated}" },
      "primary": { "$type": "color", "$value": "{color.brand.teal}" },
      "accent": { "$type": "color", "$value": "{color.brand.gold}" },
      "onDark": { "$type": "color", "$value": "#FFFFFF" },
      "onLight": { "$type": "color", "$value": "#102030" },
      "danger": { "$type": "color", "$value": "#B42318" },
      "warning": { "$type": "color", "$value": "#B54708" },
      "success": { "$type": "color", "$value": "#027A48" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "16px" },
    "control": { "$type": "dimension", "$value": "12px" }
  },
  "copy": {
    "brandName": { "$type": "string", "$value": "ReadyPackets" },
    "deliverables": { "$type": "string", "$value": "My Business Packets" }
  }
}
