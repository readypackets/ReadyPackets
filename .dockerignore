# Keep the build context small and, more importantly, keep secrets and local
# state out of the image entirely.
.git
.github
node_modules
dist
client/dist
var
coverage

# Secrets must never enter a layer.
.env
.env.*
!.env.example
deploy/tls
*.pem
*.key
*.crt

# Local development and editor state.
.vscode
.idea
*.log
*.sqlite
*.sqlite3
.DS_Store
Thumbs.db

# Documentation and tests are not needed at runtime.
docs
tests
notes
SESSION_LOG.md
